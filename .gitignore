# Telegram-боттун абалы (ар бир компьютерде өзүнчө) / состояние Telegram-бота
tools/tg_state*.json
tools/tg_state*.json.tmp
__pycache__/
# база бота (колдонуучулар, ID) — жеке маалымат
tools/tg_bot.db*
# озвучканын WAV'дары (чоң, mp3'төн кайра жасалат: tools/voice_split.py)
tools/voice/*.wav
tools/voice/_tmp_*
# Windows / редактор
Thumbs.db
desktop.ini
.env
.env.*
# Cloudflare wrangler'дин кэши
.wrangler/

# npm (Cloudflare Pages өзү орнотот)
node_modules/
# Cloudflare: локалдык сырлар (ANTHROPIC_API_KEY ж.б.)
.dev.vars
